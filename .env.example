# Public playback configuration. These values are visible in browser requests.
NEXT_PUBLIC_TWITCH_CHANNEL=dantefdd
# Exact Twitch embed parent hostnames, comma-separated without schemes or ports.
# Vercel deployment and branch hostnames are added automatically at runtime.
TWITCH_PARENT_HOSTS=
NEXT_PUBLIC_STREAM_CAM1_URL=
NEXT_PUBLIC_STREAM_CAM2_URL=
NEXT_PUBLIC_STREAM_CAM3_URL=

# Server-only Supabase project URL and service-role key. Never use NEXT_PUBLIC_ here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twitch OAuth app credentials for administrator sign-in. Server-only.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Stable Twitch user ID authorized to administer TiiA Live.
ADMIN_TWITCH_USER_ID=
# Must exactly match the callback registered in the Twitch OAuth application.
TWITCH_REDIRECT_URI=
